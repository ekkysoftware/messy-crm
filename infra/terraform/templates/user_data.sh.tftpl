#!/bin/bash
# Rendered by Terraform (infra/terraform/compute.tf) as cloud-init user data.
#
# Runs once per instance: installs Docker and the pinned Compose plugin, formats
# (only once) and mounts the encrypted data volume, installs /opt/messycrm
# (host.env, compose.yml, configure.sh, deploy.sh, messycrm.service) and starts
# the stack. Secret resolution is delegated to configure.sh, which the unit
# re-runs on every start, so a host that booted before its secrets existed
# recovers on the next restart instead of needing a rebuild.
#
# This file is a Terraform template: runtime shell expansions are written with a
# doubled dollar sign (as in shell-style braces escaped by Terraform) and are
# rendered back to single-brace form in the host script.
set -euo pipefail

app_dir=/opt/messycrm
data_mount=/srv/messycrm/postgres
data_label=messycrm-data
compose_version="${compose_version}"

echo "messycrm boot: project=${project_name} environment=${environment} host=${public_ip}"

# --- Docker, jq, AWS CLI and the pinned Compose v2 plugin --------------------
# AL2023's docker package does not ship the Compose plugin, so it is fetched
# from Docker's GitHub releases and verified against the published checksum.
dnf install -y docker jq
if ! command -v aws >/dev/null 2>&1; then
  dnf install -y awscli-2
fi
command -v aws >/dev/null 2>&1 || { echo "AWS CLI v2 is required on the host" >&2; exit 1; }
systemctl enable --now docker.service

compose_base="https://github.com/docker/compose/releases/download/v$${compose_version}"
compose_tmp="$(mktemp -d)"
curl -fsSL "$${compose_base}/docker-compose-linux-x86_64" \
  -o "$${compose_tmp}/docker-compose-linux-x86_64"
curl -fsSL "$${compose_base}/docker-compose-linux-x86_64.sha256" \
  -o "$${compose_tmp}/docker-compose-linux-x86_64.sha256"
# The published checksum file already names the file it covers, so verify it
# from a directory holding both files rather than rewriting the line.
( cd "$${compose_tmp}" && sha256sum -c docker-compose-linux-x86_64.sha256 )
install -d -m 0755 /usr/libexec/docker/cli-plugins
install -m 0755 "$${compose_tmp}/docker-compose-linux-x86_64" \
  /usr/libexec/docker/cli-plugins/docker-compose
rm -rf "$${compose_tmp}"
docker compose version

# --- Data volume: format only when unlabelled, then always mount by label ----
if [ -z "$(blkid -L "$${data_label}" || true)" ]; then
  root_source="$(findmnt -no SOURCE /)"
  root_disk="$(lsblk -no PKNAME "$${root_source}")"
  data_device=""
  while read -r candidate; do
    if [ "$(basename "$${candidate}")" = "$${root_disk}" ]; then
      continue
    fi
    if [ -z "$(blkid -p -o value -s TYPE "$${candidate}" || true)" ]; then
      data_device="$${candidate}"
      break
    fi
  done < <(lsblk -dpno NAME -e7)
  if [ -z "$${data_device}" ]; then
    echo "no unformatted data volume attached; refusing to continue" >&2
    exit 1
  fi
  mkfs.ext4 -L "$${data_label}" "$${data_device}"
fi

install -d -m 0755 "$${data_mount}"
grep -q "LABEL=$${data_label}" /etc/fstab || \
  printf 'LABEL=%s %s ext4 defaults,nofail 0 2\n' "$${data_label}" "$${data_mount}" >> /etc/fstab
mountpoint -q "$${data_mount}" || mount "$${data_mount}"

# --- Application files ------------------------------------------------------
install -d -m 0755 "$${app_dir}"

cat > "$${app_dir}/host.env" <<'HOST_ENV'
${host_env}
HOST_ENV
chmod 0644 "$${app_dir}/host.env"

cat > "$${app_dir}/compose.yml" <<'COMPOSE_YML'
${compose_file}
COMPOSE_YML
chmod 0644 "$${app_dir}/compose.yml"

cat > "$${app_dir}/configure.sh" <<'CONFIGURE_SH'
${configure_script}
CONFIGURE_SH
chmod 0755 "$${app_dir}/configure.sh"

cat > "$${app_dir}/deploy.sh" <<'DEPLOY_SH'
${deploy_script}
DEPLOY_SH
chmod 0755 "$${app_dir}/deploy.sh"

cat > /etc/systemd/system/messycrm.service <<'SYSTEMD_UNIT'
${systemd_unit}
SYSTEMD_UNIT

systemctl daemon-reload
systemctl enable messycrm.service

# configure.sh runs as the unit's ExecStartPre. If the secrets are not set yet
# it fails here with an explicit message and again on every Restart=always retry;
# nothing starts with blank credentials. A unit that cannot start yet (no image
# pushed, secrets missing) is reported by the unit's journal and does not fail
# this boot script, so `cloud-init status` stays meaningful for real failures.
systemctl start messycrm.service || \
  echo "messycrm.service did not start yet; see: journalctl -u messycrm.service" >&2
